<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bảng màu lấy từ logo CAO MINH: vàng #FBBA1F + xanh #4573E3, nền sidebar xanh navy đậm cùng tông. -->
    <Color x:Key="NavyColor">#101E4A</Color>
    <Color x:Key="NavyLightColor">#1B2D66</Color>
    <Color x:Key="NavySelectedColor">#24397D</Color>
    <Color x:Key="AccentColor">#FBBA1F</Color>
    <Color x:Key="AccentHoverColor">#F5AC00</Color>
    <Color x:Key="AccentPressedColor">#E09B00</Color>
    <Color x:Key="AccentSoftColor">#FFF6DF</Color>
    <Color x:Key="AccentBorderColor">#F7CF6E</Color>
    <Color x:Key="BlueColor">#4573E3</Color>
    <Color x:Key="BlueSoftColor">#EAF0FD</Color>

    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource NavyColor}" />
    <SolidColorBrush x:Key="NavyLightBrush" Color="{StaticResource NavyLightColor}" />
    <SolidColorBrush x:Key="NavySelectedBrush" Color="{StaticResource NavySelectedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="{StaticResource AccentBorderColor}" />
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" />
    <SolidColorBrush x:Key="BlueSoftBrush" Color="{StaticResource BlueSoftColor}" />

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F4F6FB" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E6F0" />
    <SolidColorBrush x:Key="TextBrush" Color="#101E4A" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#68728F" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#C8D2EE" />
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="#8391B8" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1D9A57" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E4F6EC" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D64545" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="WarningBrush" Color="#C77A00" />

    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
