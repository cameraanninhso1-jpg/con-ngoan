<Window x:Class="CaoMinhComputer.UI.Views.CreateChildDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo tài khoản cho con" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource UiFont}" ShowInTaskbar="False">
    <Border Background="White" CornerRadius="16" Margin="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" />
        </Border.Effect>
        <Grid>
            <Border Height="5" VerticalAlignment="Top" CornerRadius="16,16,0,0" Background="{StaticResource AccentBrush}" />
            <StackPanel Margin="28,26,28,22">
                <TextBlock Text="Tạo tài khoản Windows cho con" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="19"
                           Text="Tài khoản được tạo là Standard User (không cài được phần mềm, không gỡ được Con Ngoan) và tự động được đánh dấu là tài khoản của con." />

                <TextBlock Text="Tên đăng nhập" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" Margin="0,18,0,6" />
                <TextBox x:Name="NameInput" Style="{StaticResource Input}" Tag="Ví dụ: Bin, MinhAnh" MaxLength="20" />
                <TextBlock Text="Tên hiển thị (tùy chọn)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" Margin="0,14,0,6" />
                <TextBox x:Name="FullNameInput" Style="{StaticResource Input}" Tag="Ví dụ: Nguyễn Minh Anh" MaxLength="60" />

                <TextBlock Text="Mật khẩu Windows của con" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" Margin="0,14,0,6" />
                <PasswordBox x:Name="PasswordInput" Style="{StaticResource PasswordInput}" Tag="Mật khẩu" />
                <PasswordBox x:Name="ConfirmInput" Style="{StaticResource PasswordInput}" Tag="Nhập lại mật khẩu" Margin="0,8,0,0" />
                <TextBlock Margin="2,6,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                           Text="Có thể để trống nếu con còn nhỏ – Windows sẽ vào thẳng tài khoản không cần mật khẩu. Mật khẩu này khác mật khẩu quản trị Con Ngoan." />

                <TextBlock x:Name="ErrorText" Margin="2,12,0,0" Foreground="{StaticResource DangerBrush}" FontSize="13"
                           TextWrapping="Wrap" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Content="Hủy" Style="{StaticResource SecondaryButton}" MinWidth="96" Margin="0,0,10,0" Click="OnCancel" IsCancel="True" />
                    <Button x:Name="OkButton" Content="Tạo tài khoản" Style="{StaticResource PrimaryButton}" MinWidth="130" Click="OnOk" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
