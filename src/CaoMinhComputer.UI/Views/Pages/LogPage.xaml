<UserControl x:Class="CaoMinhComputer.UI.Views.Pages.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CaoMinhComputer.UI.Controls">
    <Grid Margin="36,30,36,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Nhật ký hoạt động" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Ghi lại thay đổi cấu hình, thao tác quản trị, chặn website/ứng dụng và trạng thái dịch vụ. Chỉ lưu trên máy này; không ghi nội dung trang web, phím bấm hay ảnh màn hình."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <c:StatusBanner x:Name="Banner" Grid.Row="1" />

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Từ ngày" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                <TextBlock Grid.Column="1" Text="Đến ngày" Style="{StaticResource Muted}" Margin="10,0,0,4" />
                <TextBlock Grid.Column="2" Text="Loại sự kiện" Style="{StaticResource Muted}" Margin="10,0,0,4" />
                <TextBlock Grid.Column="3" Text="Tìm kiếm" Style="{StaticResource Muted}" Margin="10,0,0,4" />
                <DatePicker x:Name="FromPicker" Grid.Row="1" SelectedDateFormat="Short" />
                <DatePicker x:Name="ToPicker" Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" SelectedDateFormat="Short" />
                <ComboBox x:Name="CategoryCombo" Grid.Row="1" Grid.Column="2" Margin="10,0,0,0" />
                <TextBox x:Name="SearchBox" Grid.Row="1" Grid.Column="3" Margin="10,0,0,0" Style="{StaticResource Input}" MinHeight="40"
                         Padding="12,6" Tag="Nội dung cần tìm" KeyDown="OnSearchKey" />
                <Button Grid.Row="1" Grid.Column="4" Content="Lọc" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" MinWidth="90" Click="OnFilter" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4" Margin="0">
            <DataGrid x:Name="LogGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Thời gian" Binding="{Binding TimestampLocal, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="160" />
                    <DataGridTextColumn Header="Mức" Binding="{Binding LevelText}" Width="90" />
                    <DataGridTextColumn Header="Loại" Binding="{Binding Category}" Width="140" />
                    <DataGridTemplateColumn Header="Nội dung" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <TextBlock x:Name="CountText" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="OnExport" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="Xuất CSV" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DangerButton}" Click="OnClear">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="Xóa nhật ký" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
