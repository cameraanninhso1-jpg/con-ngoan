<UserControl x:Class="CaoMinhComputer.UI.Views.Pages.AdminAccountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CaoMinhComputer.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,30,36,30">
            <TextBlock Text="Tài khoản quản trị" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Tài khoản riêng của Con Ngoan dành cho phụ huynh (khác với tài khoản Windows)." Style="{StaticResource PageSubtitle}" Margin="0,6,0,20" />

            <c:StatusBanner x:Name="Banner" />

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource AccentBrush}">
                        <TextBlock x:Name="AvatarText" FontSize="26" FontWeight="Bold" Foreground="{StaticResource NavyBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NameText" Style="{StaticResource CardTitle}" FontSize="20" />
                        <TextBlock x:Name="InfoText" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Columns="2" Margin="0,0,-16,0">
                <Border Style="{StaticResource Card}" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="Đổi tên đăng nhập" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Cần nhập mật khẩu hiện tại để xác nhận." Style="{StaticResource Muted}" Margin="0,4,0,14" />
                        <TextBox x:Name="NewUsernameBox" Style="{StaticResource Input}" Tag="Tên đăng nhập mới" Margin="0,0,0,10" />
                        <PasswordBox x:Name="UsernamePasswordBox" Style="{StaticResource PasswordInput}" Tag="Mật khẩu hiện tại" />
                        <Button Content="Lưu tên đăng nhập" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" HorizontalAlignment="Left"
                                Click="OnChangeUsername" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="Đổi mật khẩu" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Ít nhất 8 ký tự, gồm cả chữ và số." Style="{StaticResource Muted}" Margin="0,4,0,14" />
                        <PasswordBox x:Name="CurrentPasswordBox" Style="{StaticResource PasswordInput}" Tag="Mật khẩu hiện tại" Margin="0,0,0,10" />
                        <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource PasswordInput}" Tag="Mật khẩu mới" Margin="0,0,0,10" />
                        <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource PasswordInput}" Tag="Nhập lại mật khẩu mới" />
                        <Button Content="Đổi mật khẩu" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" HorizontalAlignment="Left"
                                Click="OnChangePassword" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tự đăng xuất khi không thao tác" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Tránh việc con dùng tiếp cửa sổ quản trị khi phụ huynh quên đóng." Style="{StaticResource Muted}" />
                    </StackPanel>
                    <ComboBox x:Name="IdleCombo" Grid.Column="1" SelectionChanged="OnIdleChanged">
                        <ComboBoxItem Content="Sau 5 phút" Tag="5" />
                        <ComboBoxItem Content="Sau 10 phút" Tag="10" />
                        <ComboBoxItem Content="Sau 15 phút" Tag="15" />
                        <ComboBoxItem Content="Sau 30 phút" Tag="30" />
                        <ComboBoxItem Content="Không tự đăng xuất" Tag="0" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource DarkInfoCard}">
                <StackPanel>
                    <TextBlock Text="Quên mật khẩu quản trị?" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="15" />
                    <TextBlock Foreground="White" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21" FontSize="13"
                               Text="Không có mật khẩu mặc định hay cửa sau. Người có tài khoản Administrator của Windows mở Con Ngoan (qua UAC) và bấm &quot;Quên mật khẩu?&quot; ở màn hình đăng nhập để đặt lại. Cấu hình chặn được giữ nguyên và thao tác được ghi vào nhật ký. Vì vậy, tài khoản Windows của con phải là Standard User." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
