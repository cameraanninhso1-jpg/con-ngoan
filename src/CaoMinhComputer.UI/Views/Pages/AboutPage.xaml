<UserControl x:Class="CaoMinhComputer.UI.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,30,36,30">
            <TextBlock Text="Giới thiệu" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Con Ngoan – phần mềm giúp phụ huynh quản lý máy tính Windows của con. Phát triển bởi Cao Minh Computer." Style="{StaticResource PageSubtitle}" Margin="0,6,0,20" />

            <Border Style="{StaticResource Card}" Padding="28,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{StaticResource LogoMark}" Width="120" Height="120" />
                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="30" FontWeight="Bold">
                            <Run Text="Con " Foreground="{StaticResource BlueBrush}" /><Run Text="Ngoan" Foreground="{StaticResource AccentPressedBrush}" />
                        </TextBlock>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
                        <TextBlock Text="Phát triển bởi Cao Minh Computer – CÔNG TY TNHH CAO MINH THĂNG LONG" Style="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,12,0,0">
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="14,8" Margin="0,0,10,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE717;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentPressedBrush}" Margin="0,0,8,0" />
                                    <TextBlock x:Name="HotlineText" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource BlueButton}" Click="OnWebsite" Margin="0,0,10,8" MinHeight="38" Padding="14,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                    <TextBlock x:Name="WebsiteText" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock x:Name="EnvText" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Thông điệp vì cộng đồng -->
            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1.5" CornerRadius="14" Padding="20,16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="22" Background="#DCFCE7">
                        <TextBlock Text="&#xE8D1;" Style="{StaticResource Icon}" FontSize="22" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Phần mềm phi lợi nhuận vì cộng đồng phụ huynh" FontWeight="Bold" FontSize="15" Foreground="#166534" />
                        <TextBlock Text="Con Ngoan được phát triển và tài trợ miễn phí 100% bởi CÔNG TY TNHH CAO MINH THĂNG LONG, chung tay cùng các bậc phụ huynh xây dựng môi trường máy tính an toàn, lành mạnh cho con em học tập."
                                   TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="20" Foreground="#15803D" FontSize="13" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Cập nhật phần mềm -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Cập nhật phần mềm" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="Chỉ cài bản cập nhật có chữ ký số của Cao Minh – file bị sửa hoặc giả mạo sẽ bị từ chối. Cấu hình và nhật ký được giữ nguyên." />
                        </StackPanel>
                        <CheckBox x:Name="AutoCheckToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Top" Margin="16,0,0,0"
                                  Checked="OnAutoCheckChanged" Unchecked="OnAutoCheckChanged" ToolTip="Dịch vụ tự kiểm tra bản mới mỗi ngày một lần">
                            <TextBlock Text="Tự kiểm tra mỗi ngày" Margin="8,0,0,0" />
                        </CheckBox>
                    </Grid>

                    <Border x:Name="UpdateBanner" Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="16,12" Margin="0,14,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentPressedBrush}" Margin="0,0,8,0" />
                                <TextBlock x:Name="UpdateTitle" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="UpdateNotes" Style="{StaticResource Muted}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="CheckButton" Style="{StaticResource SecondaryButton}" Click="OnCheckUpdate" Margin="0,0,10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,8,0" />
                                <TextBlock Text="Kiểm tra cập nhật" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Click="OnInstallUpdate" Margin="0,0,10,6" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,8,0" />
                                <TextBlock x:Name="InstallButtonText" Text="Cài bản cập nhật" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <UniformGrid Columns="2" Margin="0,0,-16,0">
                <Border Style="{StaticResource Card}" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="Đã có trong phiên bản này" Style="{StaticResource CardTitle}" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Style="{StaticResource Muted}" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0" LineHeight="22"
                                   Text="✔ Chặn 25 nền tảng mạng xã hội, game, web game, công cụ vượt rào và tên miền tùy chỉnh qua HOSTS (có sao lưu, chỉ sửa phần của mình)&#x0a;✔ Chặn ứng dụng theo tên tiến trình (DisallowRun) + dịch vụ tự đóng ứng dụng bị chặn&#x0a;✔ Hỗ trợ chuyển tài khoản con thành Standard User, thiết lập UAC, chặn cài MSI theo người dùng&#x0a;✔ Tài khoản quản trị riêng, mật khẩu băm PBKDF2-SHA256, khóa tạm khi nhập sai nhiều lần&#x0a;✔ Dịch vụ nền tự phục hồi HOSTS khi bị sửa&#x0a;✔ Nhật ký có lọc, tìm kiếm, xuất CSV, xóa có xác thực&#x0a;✔ Gỡ cài đặt khôi phục mọi thay đổi hệ thống" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="Tính năng nâng cao" Style="{StaticResource CardTitle}" Foreground="{StaticResource BlueBrush}" />
                        <TextBlock Style="{StaticResource Muted}" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0" LineHeight="22"
                                   Text="✔ Quản lý thời gian: giới hạn phút/ngày, khung giờ, giờ giải lao, con xin thêm giờ&#x0a;✔ AppLocker chặn cả ứng dụng portable (Windows Pro/Enterprise/Education)&#x0a;✔ Chặn website theo từng tài khoản của con&#x0a;✔ Tạo tài khoản con, đổi người dùng ngay trong app&#x0a;✔ Cập nhật phần mềm có chữ ký số của Cao Minh&#x0a;✔ Telegram (tùy chọn): duyệt xin giờ từ điện thoại, báo cáo cuối ngày&#x0a;✔ Bảo vệ trình duyệt của con: tắt DNS bảo mật, SafeSearch, khóa ẩn danh" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Dữ liệu &amp; quyền riêng tư" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="DataText" Style="{StaticResource Muted}" Margin="0,6,0,0" LineHeight="21" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
