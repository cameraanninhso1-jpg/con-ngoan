<UserControl x:Class="CaoMinhComputer.UI.Views.Pages.TimePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CaoMinhComputer.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,30,36,30">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Thời gian sử dụng" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Giới hạn số phút mỗi ngày, khung giờ được dùng máy và giờ nghỉ. Chỉ tính thời gian con thật sự dùng máy (phiên đang mở, không khóa màn hình)."
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <Border x:Name="DirtyPill" Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Top" Margin="16,4,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentPressedBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Chưa lưu thay đổi" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                </Border>
            </Grid>

            <c:StatusBanner x:Name="Banner" />

            <!-- Bật/tắt -->
            <Border Style="{StaticResource Card}" Padding="22,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="EnabledToggle" Style="{StaticResource ToggleSwitch}" Checked="OnChanged" Unchecked="OnChanged">
                        <StackPanel>
                            <TextBlock Text="Bật giới hạn thời gian" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="TimeZoneText" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </CheckBox>
                    <Button x:Name="SaveButtonTop" Grid.Column="1" Content="Lưu &amp; áp dụng" Style="{StaticResource PrimaryButton}"
                            MinWidth="190" Height="46" FontSize="16" Click="OnSave" />
                </Grid>
            </Border>

            <!-- Yêu cầu xin thêm giờ từ con -->
            <StackPanel x:Name="RequestsPanel" Visibility="Collapsed">
                <TextBlock Text="CON ĐANG XIN THÊM GIỜ" Style="{StaticResource SectionHeader}" Margin="2,4,0,8" Foreground="{StaticResource WarningBrush}" />
                <ItemsControl x:Name="RequestList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="20,14" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBorderBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Summary}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding ReasonText}" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Từ chối" Style="{StaticResource DangerButton}" Tag="deny" Click="OnDecide" Margin="0,0,10,0" />
                                        <Button Content="Đồng ý" Style="{StaticResource PrimaryButton}" Tag="approve" Click="OnDecide" MinWidth="110" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Hôm nay -->
            <Grid Margin="0,4,0,0">
                <TextBlock Text="HÔM NAY" Style="{StaticResource SectionHeader}" />
                <Button x:Name="PauseButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnTogglePause" />
            </Grid>
            <TextBlock x:Name="NoChildText" Style="{StaticResource Muted}" Foreground="{StaticResource WarningBrush}" Margin="2,0,0,12" Visibility="Collapsed"
                       Text="Chưa chọn tài khoản Windows của con. Hãy vào mục Khóa cài đặt và đánh dấu Tài khoản của con." />
            <ItemsControl x:Name="ChildList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource BlueBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,16,0">
                                    <TextBlock FontSize="16" Foreground="{StaticResource TextBrush}">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" />
                                        <Run Text="  " /><Run Text="{Binding PresenceText, Mode=OneWay}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding StateBrush}" Margin="0,4,0,8" TextWrapping="Wrap" />
                                    <ProgressBar Height="10" Maximum="{Binding LimitMinutes}" Value="{Binding UsedMinutes, Mode=OneWay}"
                                                 Foreground="{StaticResource AccentBrush}" Background="#EEF1F6" BorderThickness="0"
                                                 Visibility="{Binding HasLimit, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding UsedText}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="Cấp thêm hôm nay" Style="{StaticResource Muted}" Margin="0,0,0,6" HorizontalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="+15 phút" Tag="15" Click="OnGrant" Margin="0,0,8,0" Padding="12,8" />
                                        <Button Content="+30 phút" Tag="30" Click="OnGrant" Margin="0,0,8,0" Padding="12,8" />
                                        <Button Content="+60 phút" Tag="60" Click="OnGrant" Padding="12,8" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Lịch -->
            <TextBlock Text="LỊCH THEO NGÀY TRONG TUẦN" Style="{StaticResource SectionHeader}" Margin="2,8,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ngày (được dùng máy)" Style="{StaticResource Muted}" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="Tối đa mỗi ngày" Style="{StaticResource Muted}" FontWeight="Bold" />
                        <TextBlock Grid.Column="2" Text="Từ giờ" Style="{StaticResource Muted}" FontWeight="Bold" />
                        <TextBlock Grid.Column="4" Text="Đến giờ" Style="{StaticResource Muted}" FontWeight="Bold" />
                    </Grid>
                    <ItemsControl x:Name="DayList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource CheckSquare}" IsChecked="{Binding Allowed, Mode=TwoWay}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextBrush}" />
                                    </CheckBox>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" DisplayMemberPath="Text" SelectedValuePath="Minutes"
                                              SelectedValue="{Binding LimitMinutes, Mode=TwoWay}" IsEnabled="{Binding Allowed}" Margin="0,0,16,0" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Input}" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="vd 07:00" IsEnabled="{Binding Allowed}" />
                                    <TextBlock Grid.Column="3" Text="đến" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="4" Style="{StaticResource Input}" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="vd 21:00" IsEnabled="{Binding Allowed}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="Áp dụng Thứ Hai cho Thứ Ba → Thứ Sáu" Click="OnCopyWeekdays" Margin="0,0,10,0" />
                        <Button Content="Áp dụng Thứ Hai cho cả tuần" Click="OnCopyAll" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                               Text="Nhập giờ dạng 07:00 hoặc 7h30. Đặt &quot;Từ&quot; bằng &quot;Đến&quot; (vd 00:00–00:00) = được dùng cả ngày. Bỏ tích một ngày = không được dùng máy ngày đó." />
                </StackPanel>
            </Border>

            <!-- Giờ nghỉ -->
            <TextBlock Text="GIỜ NGHỈ – KHÔNG DÙNG MÁY (LẶP LẠI MỖI NGÀY)" Style="{StaticResource SectionHeader}" Margin="2,8,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ItemsControl x:Name="RestList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <Border Background="{StaticResource NavyBrush}" CornerRadius="16" Padding="16,6" Width="120" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBox Style="{StaticResource Input}" Width="140" Margin="18,0,0,0" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" Tag="vd 12:00" />
                                    <TextBlock Text="đến" Style="{StaticResource Muted}" Margin="14,0" VerticalAlignment="Center" />
                                    <TextBox Style="{StaticResource Input}" Width="140" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" Tag="vd 13:30" />
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource Muted}" Margin="18,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                               Text="Ví dụ: 12:00–13:30 nghỉ trưa, 22:00–06:00 không dùng máy ban đêm (khung qua nửa đêm được hỗ trợ). Để trống = không dùng khung đó." />
                </StackPanel>
            </Border>

            <!-- Không tính thời gian không thao tác -->
            <Border Style="{StaticResource Card}" Padding="22,14">
                <CheckBox x:Name="IdleCheck" Style="{StaticResource CheckSquare}" Checked="OnChanged" Unchecked="OnChanged">
                    <StackPanel>
                        <TextBlock Text="Không tính thời gian con rời máy (không thao tác quá 5 phút)" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="Cần tiện ích Con Ngoan chạy trong tài khoản của con (tự khởi động cùng Windows, có biểu tượng ở khay hệ thống). Khi đang xem video hay học trực tuyến – màn hình được giữ sáng – vẫn tính là đang dùng. Nếu con tắt Agent, thời gian vẫn được tính đầy đủ." />
                    </StackPanel>
                </CheckBox>
            </Border>

            <!-- Khi hết giờ -->
            <TextBlock Text="KHI HẾT GIỜ" Style="{StaticResource SectionHeader}" Margin="2,8,0,8" />
            <UniformGrid Columns="2" Margin="0,0,-16,16">
                <RadioButton x:Name="ActionLock" Style="{StaticResource RadioCard}" GroupName="LimitAction" Margin="0,0,16,0" Checked="OnChanged">
                    <StackPanel>
                        <TextBlock Text="Khóa máy (về màn hình đăng nhập)" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Khuyên dùng" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" FontSize="13" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Text="Ngắt phiên của con, ứng dụng và bài đang làm vẫn được giữ nguyên. Con đăng nhập lại khi chưa có thêm giờ sẽ bị khóa tiếp." />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ActionLogoff" Style="{StaticResource RadioCard}" GroupName="LimitAction" Margin="0,0,16,0" Checked="OnChanged">
                    <StackPanel>
                        <TextBlock Text="Đăng xuất" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Có thể mất dữ liệu chưa lưu" Foreground="{StaticResource DangerBrush}" FontWeight="Bold" FontSize="13" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Text="Đóng toàn bộ ứng dụng của con. Chỉ nên chọn khi con thường xuyên để máy treo game qua đêm." />
                    </StackPanel>
                </RadioButton>
            </UniformGrid>
            <Border Style="{StaticResource Card}" Padding="22,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Thời gian ân hạn để lưu bài" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Con được cảnh báo trước 5 phút và 1 phút; hết giờ còn thêm khoảng này rồi mới khóa." Style="{StaticResource Muted}" />
                    </StackPanel>
                    <ComboBox x:Name="GraceCombo" Grid.Column="1" SelectionChanged="OnGraceChanged">
                        <ComboBoxItem Content="1 phút" Tag="1" />
                        <ComboBoxItem Content="2 phút" Tag="2" />
                        <ComboBoxItem Content="5 phút" Tag="5" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Báo cáo -->
            <TextBlock Text="BÁO CÁO 7 NGÀY GẦN NHẤT" Style="{StaticResource SectionHeader}" Margin="2,8,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="ReportTitle" Style="{StaticResource Muted}" Margin="0,0,0,10" />
                    <ItemsControl x:Name="BarList" Height="170">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding ValueText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                        <Border Height="{Binding BarHeight}" CornerRadius="6,6,2,2" MaxWidth="56">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource BlueBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding Label}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Phiên sử dụng gần đây" Style="{StaticResource CardTitle}" FontSize="15" Margin="0,18,0,8" />
                    <DataGrid x:Name="SessionGrid" MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tài khoản" Binding="{Binding AccountName}" Width="160" />
                            <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartLocal, StringFormat=dd/MM/yyyy HH:mm}" Width="160" />
                            <DataGridTextColumn Header="Kết thúc" Binding="{Binding EndText}" Width="120" />
                            <DataGridTextColumn Header="Thời lượng sử dụng" Binding="{Binding DurationText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DarkInfoCard}">
                <StackPanel>
                    <TextBlock Text="Cách tính giờ &amp; giới hạn" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="15" />
                    <TextBlock Foreground="White" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21" FontSize="13"
                               Text="• Dịch vụ nền đếm thời gian khi phiên Windows của con đang mở và không khóa màn hình (máy bật nhưng con không đăng nhập thì không tính). Lúc con để máy mở mà không thao tác vẫn được tính.&#x0a;• Thời gian lưu vào database mỗi 30 giây nên tắt máy, khởi động lại, sleep/hibernate không làm mất hay cộng sai; khoảng thời gian máy ngủ không bị tính.&#x0a;• Lịch tính theo múi giờ phụ huynh cài đặt; thời gian dùng được đếm bằng đồng hồ nội bộ nên chỉnh đồng hồ máy không gian lận được (và được ghi nhật ký).&#x0a;• Cấp thêm giờ và tạm dừng cần đăng nhập quản trị. Con Ngoan không bao giờ tắt máy của con." />
                </StackPanel>
            </Border>

            <Button x:Name="SaveButton" Content="Lưu &amp; áp dụng" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                    MinWidth="200" Height="48" FontSize="16" Click="OnSave" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
