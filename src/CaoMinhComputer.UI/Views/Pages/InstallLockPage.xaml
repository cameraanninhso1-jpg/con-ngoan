<UserControl x:Class="CaoMinhComputer.UI.Views.Pages.InstallLockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CaoMinhComputer.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,30,36,30">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Khóa cài đặt phần mềm" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Dùng cơ chế chuẩn của Windows: tài khoản của con là Standard User, mọi cài đặt cần quyền quản trị sẽ phải nhập mật khẩu Windows của phụ huynh."
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <Border x:Name="DirtyPill" Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Top" Margin="16,4,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentPressedBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Chưa lưu thay đổi" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                </Border>
            </Grid>

            <c:StatusBanner x:Name="Banner" />

            <!-- Phiên bản Windows -->
            <Border Style="{StaticResource Card}" Padding="22,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource BlueSoftBrush}">
                        <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="EditionText" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="EditionSupportText" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tài khoản -->
            <TextBlock Text="BƯỚC 1 · TÀI KHOẢN WINDOWS TRÊN MÁY" Style="{StaticResource SectionHeader}" Margin="2,6,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                               Text="Đánh dấu tài khoản mà con sử dụng. Tài khoản của con nên là Standard User; tài khoản phụ huynh giữ quyền Administrator. Thay đổi loại tài khoản có hiệu lực từ lần đăng nhập tiếp theo." />
                    <TextBlock x:Name="NoAccountsText" Visibility="Collapsed" Style="{StaticResource Muted}" Foreground="{StaticResource WarningBrush}"
                               Text="Máy chưa có tài khoản Windows nào cho con. Bấm &quot;Tạo tài khoản cho con&quot; bên dưới – không cần vào Settings của Windows." />
                    <ItemsControl x:Name="AccountsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EEF1F6" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="20" Background="{Binding AvatarBrush}">
                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="15" Foreground="{StaticResource TextBrush}">
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" />
                                                <Run Text="{Binding Tags, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" FontSize="13" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding TypeText}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding TypeBrush}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" Style="{StaticResource CheckSquare}" IsChecked="{Binding IsChild, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanBeChild}" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Tài khoản của con" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                        </CheckBox>
                                        <Button Grid.Column="3" Content="{Binding ActionText}" Click="OnAccountAction" Tag="{Binding}"
                                                IsEnabled="{Binding CanChangeType}" MinWidth="200" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="CreateChildButton" Style="{StaticResource PrimaryButton}" Click="OnCreateChild" Margin="0,0,10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FA;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,8,0" />
                                <TextBlock Text="Tạo tài khoản cho con" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Click="OnSwitchUser" Margin="0,0,10,6"
                                ToolTip="Về màn hình đăng nhập Windows để chọn tài khoản của con hoặc tài khoản khác">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE748;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,8,0" />
                                <TextBlock Text="Đổi người dùng Windows" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- UAC -->
            <TextBlock Text="BƯỚC 2 · KHI CON CHẠY FILE CÀI ĐẶT CẦN QUYỀN QUẢN TRỊ" Style="{StaticResource SectionHeader}" Margin="2,6,0,8" />
            <Border x:Name="UacOffWarning" Background="{StaticResource DangerSoftBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" Foreground="#A12E2E" FontSize="13"
                           Text="UAC (User Account Control) đang TẮT trên máy này. Khi UAC tắt, các thiết lập bên dưới không có tác dụng. Hãy bật lại UAC trong Control Panel › User Accounts › Change User Account Control settings rồi khởi động lại máy. Con Ngoan không tự thay đổi UAC." />
            </Border>
            <UniformGrid Columns="2" Margin="0,0,-16,16">
                <RadioButton x:Name="RadioPrompt" Style="{StaticResource RadioCard}" GroupName="Uac" Margin="0,0,16,0" Checked="OnChanged">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="52" Height="52" CornerRadius="12" Background="{StaticResource NavyBrush}">
                                <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Yêu cầu mật khẩu" Style="{StaticResource CardTitle}" FontSize="18" />
                                <TextBlock Text="Khuyên dùng" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0"
                                   Text="Windows hiện hộp thoại UAC yêu cầu tài khoản + mật khẩu Administrator (của phụ huynh). Con không biết mật khẩu thì không cài được. Đây là thiết lập mặc định của Windows." />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="RadioDeny" Style="{StaticResource RadioCard}" GroupName="Uac" Margin="0,0,16,0" Checked="OnChanged">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="52" Height="52" CornerRadius="12" Background="#E9ECF3">
                                <TextBlock Text="&#xE8F8;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Tự động từ chối" Style="{StaticResource CardTitle}" FontSize="18" />
                                <TextBlock Text="Nghiêm ngặt" Foreground="{StaticResource WarningBrush}" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0"
                                   Text="Mọi yêu cầu nâng quyền từ tài khoản Standard User bị từ chối ngay, không hiện ô nhập mật khẩu. Phụ huynh muốn cài phần mềm phải đăng nhập tài khoản của mình." />
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="MsiCheck" Style="{StaticResource CheckSquare}" Checked="OnChanged" Unchecked="OnChanged">
                        <StackPanel>
                            <TextBlock Text="Chặn cài đặt MSI theo từng người dùng (không cần quyền quản trị)" FontWeight="SemiBold" FontSize="15"
                                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="Bật chính sách Windows Installer DisableUserInstalls: gói .msi cài riêng cho người dùng sẽ không chạy được. Không ảnh hưởng tới cài đặt bởi quản trị viên." />
                            <TextBlock x:Name="MsiForeignNote" Style="{StaticResource Muted}" Foreground="{StaticResource WarningBrush}" Visibility="Collapsed"
                                       Text="Chính sách này đang được đặt bởi phần mềm/quản trị khác; Con Ngoan sẽ không gỡ nó." />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- AppLocker -->
            <TextBlock Text="BƯỚC 3 · CHẶN GAME PORTABLE &amp; FILE TẢI VỀ (APPLOCKER)" Style="{StaticResource SectionHeader}" Margin="2,6,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="AppLockerBadgeBg" Width="44" Height="44" CornerRadius="12" Background="{StaticResource BlueSoftBrush}">
                            <TextBlock x:Name="AppLockerBadge" Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="AppLockerTitle" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="AppLockerDetail" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="StrictCheck" Style="{StaticResource CheckSquare}" Checked="OnStrictChanged" Unchecked="OnStrictChanged">
                        <StackPanel>
                            <TextBlock Text="Chế độ nghiêm ngặt" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="Tài khoản của con chỉ chạy được ứng dụng trong Windows và Program Files (do phụ huynh cài) cùng các thư mục được phép bên dưới. Mọi file .exe ở Downloads, Desktop, Documents, thư mục Temp, USB/ổ đĩa ngoài (kể cả game portable, file tải về) đều bị chặn – Windows báo &quot;bị chặn bởi quản trị viên&quot;. Không hỏi mật khẩu: muốn cho con dùng, phụ huynh cài ứng dụng bằng tài khoản quản trị." />
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Text="Thư mục được phép thêm (mỗi dòng một thư mục, dùng %USERPROFILE% cho thư mục của con)" Style="{StaticResource Muted}"
                               FontWeight="SemiBold" Margin="40,16,0,6" />
                    <TextBox x:Name="AllowedFoldersBox" Style="{StaticResource Input}" AcceptsReturn="True" TextWrapping="NoWrap" Height="120"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="40,0,0,0" TextChanged="OnFoldersChanged" FontSize="13" />
                    <TextBlock Style="{StaticResource Muted}" Margin="40,8,0,0"
                               Text="Mặc định cho phép OneDrive, Microsoft Teams, Zoom (cài theo từng người dùng) để học trực tuyến không bị gián đoạn. Danh sách ứng dụng bị chặn ở mục Chặn web &amp; game cũng được AppLocker chặn theo tên file ở mọi thư mục." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DarkInfoCard}">
                <StackPanel>
                    <TextBlock Text="Cách hoạt động &amp; giới hạn" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="15" />
                    <TextBlock Foreground="White" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21" FontSize="13">
                        <Run Text="• Cài đặt cần quyền Administrator (ghi vào Program Files, cài driver/dịch vụ): bị chặn bởi UAC khi con dùng Standard User." /><LineBreak />
                        <Run Text="• Ứng dụng portable hoặc trình cài 'per-user' (cài vào AppData, ví dụ một số launcher game): KHÔNG cần quyền quản trị nên UAC không chặn được. Hãy thêm tên tiến trình vào danh sách chặn ứng dụng ở mục Chặn web &amp; game." /><LineBreak />
                        <Run Text="• AppLocker (Bước 3) chặn được cả file portable trên Windows Enterprise/Education (Pro thường hoạt động). Windows Home dùng DisallowRun + dịch vụ đóng ngay ứng dụng bị chặn khi vừa mở (bản portable đổi tên file vẫn có thể lọt)." /><LineBreak />
                        <Run Text="• Con Ngoan không tắt UAC, Windows Defender hay Windows Update. Mọi thay đổi được ghi nhật ký và khôi phục khi gỡ cài đặt." />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Button x:Name="SaveButton" Content="Lưu &amp; áp dụng" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                    MinWidth="200" Height="48" FontSize="16" Click="OnSave" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
