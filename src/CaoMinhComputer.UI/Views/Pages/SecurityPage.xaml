<UserControl x:Class="CaoMinhComputer.UI.Views.Pages.SecurityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CaoMinhComputer.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,30,36,30">
            <TextBlock Text="Bảo mật &amp; gỡ app" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Trạng thái dịch vụ bảo vệ, kiểm tra toàn vẹn cấu hình, tạm tắt bảo vệ và gỡ cài đặt hợp lệ." Style="{StaticResource PageSubtitle}" Margin="0,6,0,20" />

            <c:StatusBanner x:Name="Banner" />

            <!-- Dịch vụ nền -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ServiceIconBg" Width="52" Height="52" CornerRadius="14" Background="{StaticResource SuccessSoftBrush}">
                        <TextBlock x:Name="ServiceIcon" Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="24" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ServiceTitle" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="ServiceDetail" Style="{StaticResource Muted}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StartServiceButton" Content="Khởi động" Style="{StaticResource BlueButton}" Click="OnStartService" Margin="0,0,10,0" />
                        <Button x:Name="RestartServiceButton" Content="Khởi động lại" Click="OnRestartService" Margin="0,0,10,0" />
                        <Button x:Name="StopServiceButton" Content="Dừng" Style="{StaticResource DangerButton}" Click="OnStopService" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bảo vệ -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="ProtectionTitle" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="ProtectionDetail" Style="{StaticResource Muted}" />
                    </StackPanel>
                    <Button x:Name="ProtectionButton" Grid.Column="1" Click="OnToggleProtection" MinWidth="200" />
                </Grid>
            </Border>

            <!-- Điều khiển từ xa qua Telegram -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Thông báo &amp; điều khiển từ xa qua Telegram" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Nhận thông báo khi con xin thêm giờ, duyệt bằng nút bấm, xem tình trạng và báo cáo cuối ngày trên điện thoại." Style="{StaticResource Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox x:Name="TelegramEnabledBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="OnTelegramConfigChanged" Unchecked="OnTelegramConfigChanged" />
                    </Grid>

                    <StackPanel x:Name="TelegramConfigPanel" Margin="0,14,0,0">
                        <TextBlock Text="Bot Token (tạo từ @BotFather):" Style="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="TelegramTokenBox" Style="{StaticResource Input}" Tag="Ví dụ: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ" Margin="0,0,0,12" />

                        <TextBlock Text="Telegram Chat ID của phụ huynh:" Style="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="TelegramChatIdBox" Style="{StaticResource Input}" Tag="Ví dụ: 987654321 (lấy từ bot @userinfobot)" Margin="0,0,0,12" />
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                            <TextBlock TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource TextBrush}" FontSize="13"
                                       Text="🔒 Dữ liệu gửi qua máy chủ Telegram: tên tài khoản của con, tên máy, số phút đã dùng/còn lại, lý do con xin thêm giờ và số lần ứng dụng bị chặn. KHÔNG chụp màn hình, không gửi nội dung web con xem. Chỉ nhận lệnh từ tin nhắn RIÊNG với bot từ đúng Chat ID trên (tin trong nhóm bị bỏ qua); lệnh tạm tắt bảo vệ phải bấm xác nhận; mọi lệnh được ghi nhật ký." />
                        </Border>

                        <CheckBox x:Name="TelegramNotifyBox" Style="{StaticResource CheckSquare}" Margin="0,0,0,10">
                            <TextBlock Text="Gửi thông báo đẩy khi con bấm xin thêm giờ" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        </CheckBox>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="TelegramDailyReportBox" Style="{StaticResource CheckSquare}" VerticalAlignment="Center">
                                <TextBlock Text="Tự động gửi báo cáo tổng kết ngày vào lúc:" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            </CheckBox>
                            <TextBox x:Name="TelegramDailyTimeBox" Grid.Column="1" Style="{StaticResource Input}" Width="90" Text="21:00" ToolTip="Định dạng HH:mm, ví dụ 21:00" />
                        </Grid>

                        <WrapPanel>
                            <Button Content="Lưu cấu hình Telegram" Style="{StaticResource PrimaryButton}" Click="OnSaveTelegram" Margin="0,0,10,0" MinWidth="170" />
                            <Button x:Name="TestTelegramButton" Content="Gửi tin nhắn thử nghiệm" Click="OnTestTelegram" MinWidth="170" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" LineHeight="19"
                                   Text="💡 Hướng dẫn: 1. Mở Telegram tìm @BotFather, gõ /newbot để lấy Token. 2. Tìm @userinfobot bấm Start để lấy Chat ID. 3. Mở bot của bạn, bấm Start rồi quay lại đây bấm Gửi tin nhắn thử nghiệm." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Chống can thiệp cho tài khoản con -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Chống can thiệp hệ thống trên tài khoản con" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Chỉ áp dụng cho tài khoản của con. (Đổi giờ hệ thống không lách được giới hạn: tài khoản Standard User không có quyền đổi giờ, và thời gian dùng máy được đếm bằng đồng hồ riêng.)"  TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,14" />

                    <CheckBox x:Name="AntiTamperBox" Style="{StaticResource CheckSquare}" Margin="0,0,0,12" Checked="OnAntiTamperChanged" Unchecked="OnAntiTamperChanged">
                        <StackPanel>
                            <TextBlock Text="Khóa Task Manager, Registry Editor và Command Prompt (CMD)" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Style="{StaticResource Muted}" Text="Con không mở được Task Manager (để tắt tiện ích), Registry Editor và cửa sổ CMD. File .bat của trường vẫn chạy được." />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox x:Name="SuperviseAgentBox" Style="{StaticResource CheckSquare}" Checked="OnAntiTamperChanged" Unchecked="OnAntiTamperChanged">
                        <StackPanel>
                            <TextBlock Text="Tự động khởi động lại tiện ích Agent của con nếu bị đóng" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Style="{StaticResource Muted}" Text="Dịch vụ nền kiểm tra định kỳ và mở lại tiện ích ở khay hệ thống (để con xin thêm giờ, nhận cảnh báo hết giờ) nếu con tắt nó." />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox x:Name="RealtimeBox" Style="{StaticResource CheckSquare}" Margin="0,12,0,0" Checked="OnAntiTamperChanged" Unchecked="OnAntiTamperChanged">
                        <StackPanel>
                            <TextBlock Text="Đóng ứng dụng bị chặn ngay khi vừa mở" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Dịch vụ nhận sự kiện mở chương trình của Windows và đóng ngay ứng dụng trong danh sách chặn của con (hữu ích trên Windows Home, nơi không có AppLocker)." />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Kiểm tra -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Kiểm tra toàn vẹn cấu hình" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Kiểm tra database, so khớp HOSTS với cấu hình và tự sửa nếu bị thay đổi." Style="{StaticResource Muted}" />
                        </StackPanel>
                        <Button x:Name="CheckButton" Grid.Column="1" Content="Kiểm tra ngay" Style="{StaticResource PrimaryButton}" Click="OnCheck" MinWidth="160" />
                    </Grid>
                    <TextBlock x:Name="CheckDetail" Style="{StaticResource Muted}" Margin="0,12,0,0" LineHeight="21" Visibility="Collapsed" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Click="OnOpenData" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                <TextBlock Text="Mở thư mục dữ liệu &amp; bản sao lưu HOSTS" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Gỡ cài đặt -->
            <Border Style="{StaticResource Card}" BorderBrush="#F2C4C4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Gỡ cài đặt Con Ngoan" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="Bộ gỡ cài đặt sẽ dừng và xóa dịch vụ, khôi phục HOSTS, DisallowRun và chính sách Windows về như trước khi cài. Bạn được hỏi có giữ lại dữ liệu/nhật ký hay không." />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Gỡ cài đặt..." Style="{StaticResource DangerButton}" Click="OnUninstall" MinWidth="160" />
                </Grid>
            </Border>

            <Border Style="{StaticResource DarkInfoCard}">
                <StackPanel>
                    <TextBlock Text="Nguyên tắc bảo vệ minh bạch" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="15" />
                    <TextBlock Foreground="White" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21" FontSize="13"
                               Text="• Dịch vụ ConNgoanService hiển thị công khai trong services.msc, không ẩn tiến trình, không keylog, không chụp màn hình.&#x0a;• Thư mục dữ liệu chỉ SYSTEM và Administrators truy cập được; tài khoản Standard User của con không đọc/sửa được cấu hình.&#x0a;• Phụ huynh luôn có thể tắt bảo vệ hoặc gỡ cài đặt bằng tài khoản Administrator (Settings › Apps hoặc nút ở trên)." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
