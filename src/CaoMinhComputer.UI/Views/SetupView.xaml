<UserControl x:Class="CaoMinhComputer.UI.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="AuthBackground.xaml" />
    </UserControl.Resources>
    <Grid Style="{StaticResource AuthRoot}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" Margin="0,30">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <Border Background="White" CornerRadius="18" Padding="6" Width="80" Height="80">
                        <Image Source="{StaticResource LogoMark}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="Con" FontSize="34" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Ngoan" FontSize="34" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,-10,0,0" />
                        <TextBlock Text="phát triển bởi Cao Minh Computer" FontSize="13" Foreground="#AFC0EA" Margin="2,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource AuthCard}" Width="500">
                    <StackPanel>
                        <TextBlock Text="Thiết lập quản trị lần đầu" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Tạo tài khoản quản trị dành riêng cho phụ huynh. Mật khẩu được băm PBKDF2-SHA256, không lưu dạng văn bản."
                                   Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,8,0,22" />
                        <TextBox x:Name="UsernameBox" Style="{StaticResource Input}" Tag="Tên đăng nhập (ví dụ: phuhuynh)" Margin="0,0,0,12" />
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordInput}" Tag="Mật khẩu (ít nhất 8 ký tự, có chữ và số)" Margin="0,0,0,12" />
                        <PasswordBox x:Name="ConfirmBox" Style="{StaticResource PasswordInput}" Tag="Nhập lại mật khẩu" />
                        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="13" Margin="2,10,0,0"
                                   TextWrapping="Wrap" Visibility="Collapsed" />
                        <Border Background="{StaticResource BlueSoftBrush}" CornerRadius="10" Padding="14,10" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource Muted}" Foreground="{StaticResource TextBrush}"
                                       Text="Lưu ý: hãy đặt mật khẩu khác mật khẩu Windows và không cho con biết. Nếu quên, người có quyền Administrator Windows có thể đặt lại (xem hướng dẫn)." />
                        </Border>
                        <Button x:Name="CreateButton" Content="TẠO TÀI KHOẢN QUẢN TRỊ" Style="{StaticResource PrimaryButton}"
                                Margin="0,20,0,0" Height="50" FontSize="15" Click="OnCreate" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
