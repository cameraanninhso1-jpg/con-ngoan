<Window x:Class="CaoMinhComputer.UI.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Con Ngoan" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource UiFont}" ShowInTaskbar="False">
    <Border Background="White" CornerRadius="16" Margin="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" />
        </Border.Effect>
        <Grid>
            <Border Height="5" VerticalAlignment="Top" CornerRadius="16,16,0,0" Background="{StaticResource AccentBrush}" />
            <StackPanel Margin="28,26,28,22">
                <TextBlock x:Name="TitleText" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" Margin="0,10,0,0" FontSize="14" Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap" LineHeight="21" />
                <StackPanel x:Name="PasswordPanel" Visibility="Collapsed" Margin="0,16,0,0">
                    <PasswordBox x:Name="PasswordInput" Style="{StaticResource PasswordInput}" Tag="Mật khẩu quản trị Con Ngoan" />
                    <TextBlock x:Name="ErrorText" Margin="2,8,0,0" Foreground="{StaticResource DangerBrush}" FontSize="13"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="CancelButton" Content="Hủy" Style="{StaticResource SecondaryButton}" MinWidth="96"
                            Margin="0,0,10,0" Click="OnCancel" IsCancel="True" />
                    <Button x:Name="OkButton" Content="Đồng ý" Style="{StaticResource PrimaryButton}" MinWidth="110"
                            Click="OnOk" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
