<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CaoMinhComputer.Service</RootNamespace>
    <AssemblyName>ConNgoan.Service</AssemblyName>
    <ApplicationIcon>..\CaoMinhComputer.UI\Assets\app.ico</ApplicationIcon>
    <!-- Giảm RAM khi nhàn rỗi -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CaoMinhComputer.Core\CaoMinhComputer.Core.csproj" />
    <ProjectReference Include="..\CaoMinhComputer.Data\CaoMinhComputer.Data.csproj" />
  </ItemGroup>
</Project>
